// SPDX-License-Identifier: 0BSD
struct SprEntry {
  u32 pc;

  u8 wait;
  u8 loop;
  u8 sheet;
  u8 {
    u1 xyDirty;
    u1 angDirty;
    u1 hide;
    u1 clone;
    u1 world;
    u1 stackedWidth; // for sprites with two OAM/VRAM handles, stacked along width or height?
    u1 rotateAlloc;
    u1;
  } flags;

  i8 oamHandle1;
  i8 oamHandle2; // possibly -1
  i16 vramObjHandle1;
  i16 vramObjHandle2; // possibly -1

  // Q8.8
  i16 gravity;
  i16 offsetX;
  i16 offsetY;
  i16 offsetDX;
  i16 offsetDY;

  // Q16.0
  i16 originX;
  i16 originY;

  i8 rotateOriginX;
  i8 rotateOriginY;
  u8 rotateAngle;
  u8 {
    u6 rotateIndex;
    u1 rotateHFlip;
    u1 rotateVFlip;
  } rotateFlags;
};
