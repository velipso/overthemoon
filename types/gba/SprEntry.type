// SPDX-License-Identifier: 0BSD
struct SprEntry {
  u32 pc;

  u16 {
    u4 wait;
    u1 xyDirty;
    u1 angDirty;
    u1 visible;
    u1 clone;
    u1 worldSpace;
    u1 gravityAxisX;
    u1 fireResult;
    u1 stackedWidth; // for sprites with two OAM/VRAM handles, stacked along width or height?
    u1 jumpCondition;
    u3;
  } flags;
  u8 repeat;
  u8 spritesheet;

  i8 oamHandle1;
  i8 oamHandle2; // possibly -1
  i16 vramObjHandle1;
  i16 vramObjHandle2; // possibly -1

  // Q8.8
  i16 gravity;
  i16 localX;
  i16 localY;
  i16 localDX;
  i16 localDY;

  // Q16.0
  i16 originX;
  i16 originY;

  i8 rotateOriginX;
  i8 rotateOriginY;
  u8 rotateAngle;
  u8 {
    u5 rotateIndex;
    u1 rotateHFlip;
    u1 rotateVFlip;
    u1 rotateAlloc;
  } rotateFlags;
};
